{
  "name": "cablewise",
  "productName": "Cablewise",
  "version": "0.3.0-rc.2",
  "private": true,
  "description": "线知 — 面向普通人的线材与连接检查工具",
  "author": "Cablewise",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64 --x64"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "plist": "^3.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.3",
    "vite": "8.3.6",
    "@playwright/test": "latest"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "app.cablewise.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "electron/native/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "artifactName": "Cablewise-${version}-${os}-${arch}.${ext}"
  }
}
